#!groovy

// trick from https://github.com/jenkinsci/workflow-cps-global-lib-plugin/pull/43
def lib = library identifier: 'sct@snapshot', retriever: legacySCM(scm)

// Write workload only, one 50k op/s step: the A/B check for S3 client changes against the write P99.
// Same setup as scylla-enterprise-perf-regression-predefined-throughput-steps-s3-tablets.jenkinsfile,
// with the steps file overridden by the write-50k one and the read sub-test left out.
perfRegressionParallelPipeline(
    backend: "aws",
    region: "us-east-1",
    provision_type: 'on_demand',
    test_name: "performance_regression_gradual_grow_throughput.PerformanceRegressionPredefinedStepsTest",
    test_config: '''["test-cases/performance/perf-regression-predefined-throughput-steps-object-storage.yaml", "configurations/performance/cassandra_stress_gradual_load_steps_object_storage.yaml", "configurations/disable_kms.yaml", "configurations/disable_speculative_retry.yaml", "configurations/performance/latency-decorator-error-thresholds-steps-ent-tablets.yaml", "configurations/object_storage_s3.yaml", "configurations/aws/perf-regression-predefined-throughput-steps-s3.yaml", "configurations/performance/cassandra_stress_gradual_load_steps_object_storage_write_50k.yaml"]''',
    sub_tests: ["test_write_gradual_increase_load"],
)
